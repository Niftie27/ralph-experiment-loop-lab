[Unit]
Description=RALPH collector lossless storage maintenance

[Service]
Type=oneshot
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
ExecStart=%h/venv-collector/bin/python %h/ralph_collector/storage_maintenance.py --symbol BTCUSDT --data %h/data/binance --features %h/data/features --repo %h/ralph-experiment-loop-lab --retention-days 7 --apply
ExecStart=%h/venv-collector/bin/python %h/ralph_collector/storage_maintenance.py --symbol ETHUSDT --data %h/data/binance-ethusdt --features %h/data/features-ethusdt --repo %h/ralph-experiment-loop-lab --retention-days 7 --apply
ExecStart=%h/venv-collector/bin/python %h/ralph_collector/storage_maintenance.py --symbol SOLUSDT --data %h/data/binance-solusdt --features %h/data/features-solusdt --repo %h/ralph-experiment-loop-lab --retention-days 7 --apply
ExecStart=%h/venv-collector/bin/python %h/ralph_collector/storage_maintenance.py --symbol HYPEUSDT --data %h/data/binance-hypeusdt --features %h/data/features-hypeusdt --repo %h/ralph-experiment-loop-lab --retention-days 7 --apply
